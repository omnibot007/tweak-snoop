    "CleanHelper": {
      "file": "Optimizer/CleanHelper.cs",
      "preview_temp": "TempFolder (%TEMP%) + Profiling",
      "preview_minidumps": "%WINDIR%\\Minidump",
      "preview_error_reports": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER\\* + %ProgramData%\\Microsoft\\Windows\\WER\\*",
      "browser_targets": [
        "IE INetCache/WebCache",
        "Chrome Default/Cache,Code Cache,GPUCache,Service Worker,File System,Login Data",
        "Firefox Profiles cookies.sqlite/places.sqlite/cache2",
        "Edge Cache/Cookies/History/Session",
        "Brave Cache/Cookies/History/Session/Login Data"
      ],
      "recycle_bin": "SHEmptyRecycleBin",
      "note": "All via PreviewFolder->Clean() = File.Delete/Directory.Delete \u2014 DESTRUCTIVE, no recycle fallback like pc-tweaker"
    },
    "UWPHelper": {
      "file": "Optimizer/UWPHelper.cs",
      "get": "Get-AppxPackage | Select Name,InstallLocation (or Where NonRemovable=False)",
      "uninstall": "Get-AppxPackage -AllUsers {app} | Remove-AppxPackage",
      "restore": "Get-AppxPackage -AllUsers | Foreach {Add-AppxPackage -DisableDevelopmentMode -Register \\.InstallLocation\\AppXManifest.xml}",
      "note": "Full UWP catalog, not just 17 like Viridian \u2014 any AppX"
    },
    "StartupHelper": {
      "file": "Optimizer/StartupHelper.cs",
      "keys": [
        "HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM\\RunOnce",
        "HKLM\\Wow6432Node\\...\\Run",
        "HKCU\\Software\\...\\Run",
        "HKCU\\RunOnce",
        "%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup",
        "%APPDATA%\\...\\Startup"
      ],
      "note": "Enumerates reg + folder startups, toggles via registry/folder delete"
    },
    "HostsHelper": {
      "file": "Optimizer/HostsHelper.cs",
      "path": "%SystemRoot%\\System32\\drivers\\etc\\hosts",
      "ops": [
        "ReadHosts",
        "SaveHosts (sanitize double spaces)",
        "AddEntry",
        "RemoveEntry",
        "RemoveEntryFromTemplate",
        "RestoreDefaultHosts (from Resources/hosts)",
        "ReadOnly toggle"
      ],
      "note": "Hosts blocklist editor, can lock read-only"
    },
    "Utilities_extra": {
      "files": [
        "Optimizer/Utilities.cs",
